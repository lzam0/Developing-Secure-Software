{
  "type": "module",
  "name": "backend",
  "version": "1.0.0",
  "description": "Developing Secure Software project",
  "scripts": {
    "dev": "nodemon server.js",
    "start": "node server.js",
    "db": "docker-compose -f ../docker-compose.yml down -v && docker-compose -f ../docker-compose.yml up --build -d",
    "test": "mocha",
    "test:unit": "mocha --spec test/unit/**/*.test.js",
    "test:integration": "mocha --spec test/integration/**/*.test.js --timeout 10000",
    "test:security": "mocha --spec test/security/**/*.test.js",
    "test:watch": "mocha --watch",
    "test:coverage": "nyc mocha",
    "test:auth": "mocha test/unit/auth.test.js --timeout 5000",
    "test:user": "mocha test/unit/user.test.js --timeout 5000",
    "test:api": "mocha test/integration/api.test.js --timeout 10000",
    "test:login-security": "mocha test/security/login.security.test.js --timeout 5000",
    "test:jwt-security": "mocha test/security/jwt.security.test.js --timeout 5000",
    "test:cookie": "mocha test/security/cookie.security.test.js --timeout 5000",
    "test:validation-security": "mocha test/security/validation.security.test.js --timeout 5000"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "chai": "^6.2.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.3.2",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "mocha": "^11.7.5",
    "pg": "^8.20.0",
    "sanitize-html": "^2.17.3"
  },
  "devDependencies": {
    "nodemon": "^3.1.14",
    "sinon": "^21.0.3",
    "supertest": "^7.2.2"
  }
}
